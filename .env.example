# Copy this file to .env only for local reference. The application reads
# environment variables supplied by the launcher; it never packages .env files.

# Optional. Required before the HIBP account and paste endpoints are called.
HIBP_API_KEY=

# Optional HTTP timeout in milliseconds. Allowed range: 1000-60000.
OSINT_HTTP_TIMEOUT_MS=10000

# Optional retry count for idempotent GET requests. Allowed range: 0-3.
OSINT_HTTP_RETRIES=2

# Never put target identifiers, investigation notes, or production keys here.
